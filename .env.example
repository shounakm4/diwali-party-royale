# Leave unset for durable SQLite LAN play on your laptop (Node 22.13+).
# Production on Vercel REQUIRES all three Supabase variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional LAN address for QR codes, e.g. http://192.168.1.20:3000
NEXT_PUBLIC_JOIN_ORIGIN=
